{
  "name": "mai-habi",
  "private": true,
  "version": "0.1.0",
  "description": "HABI — a browser code playground that compiles locally, including its landing pages and documentation.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @mai-habi/web",
    "dev:web": "npm run dev --workspace @mai-habi/web",
    "build": "npm run build:web",
    "start": "npm run start --workspace @mai-habi/web",
    "build:web": "npm run build --workspace @mai-habi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "node scripts/verify.mjs",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "postinstall": "node scripts/sync-runtime.mjs",
    "prebuild": "node scripts/sync-runtime.mjs",
    "clean": "node -e \"const{rmSync}=require('fs');['node_modules','apps/web/node_modules','apps/web/.next','apps/web/dist','apps/web/.vercel'].forEach(p=>rmSync(p,{recursive:true,force:true}))\""
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lenis": "^1.3.26",
    "motion": "^13.1.0",
    "typescript": "^5.7.3",
    "zustand": "^5.0.14"
  }
}
