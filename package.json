{
  "name": "mai-habi",
  "private": true,
  "version": "0.1.0",
  "description": "HABI — a browser code playground that compiles locally, plus its marketing site and documentation.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @mai-habi/web",
    "dev:web": "npm run dev --workspace @mai-habi/web",
    "dev:marketing": "npm run dev --workspace @mai-habi/marketing",
    "dev:docs": "npm run dev --workspace @mai-habi/docs",
    "build": "npm run build:web && npm run build:marketing && npm run build:docs",
    "build:web": "npm run build --workspace @mai-habi/web",
    "build:marketing": "npm run build --workspace @mai-habi/marketing",
    "build:docs": "npm run build --workspace @mai-habi/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "node scripts/verify.mjs",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "postinstall": "node scripts/sync-runtime.mjs",
    "prebuild": "node scripts/sync-runtime.mjs",
    "clean": "node -e \"const{rmSync}=require('fs');['node_modules','apps/web/node_modules','apps/web/dist','apps/web/.astro','apps/web/.vercel','apps/marketing/dist','apps/marketing/.astro','apps/marketing/.vercel','apps/docs/dist','apps/docs/.astro'].forEach(p=>rmSync(p,{recursive:true,force:true}))\"",
    "sync:icons": "node scripts/sync-icons.mjs"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lenis": "^1.3.26",
    "motion": "^13.1.0",
    "simple-icons": "^16.28.0",
    "typescript": "^5.7.3",
    "zustand": "^5.0.14"
  }
}
