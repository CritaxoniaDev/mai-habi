---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const appOrigin = import.meta.env.PUBLIC_APP_ORIGIN ?? 'http://localhost:4321';

/* Newest first. The filename orders nothing — the date does. */
const entries = (await getCollection('changelog')).sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime() ||
    // Same-day releases would otherwise fall back to filename order.
    b.data.version.localeCompare(a.data.version, undefined, { numeric: true }),
);

const releases = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);

const KIND_LABEL = {
  added: 'Added',
  improved: 'Improved',
  fixed: 'Fixed',
} as const;

const KIND_TONE = {
  added: 'text-success',
  improved: 'text-foreground',
  fixed: 'text-warning',
} as const;

const dateFormat = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title="Changelog — HABI"
  description="What has changed in HABI: the browser code playground that compiles on your own machine."
>
  <section class="mx-auto max-w-4xl px-6 pb-10 pt-16 sm:pt-20">
    <p class="text-label uppercase tracking-[0.16em] text-muted-foreground">Changelog</p>

    <h1 class="mt-5 max-w-2xl text-headline font-light text-foreground">
      What has changed
    </h1>

    <p class="mt-5 max-w-2xl text-body font-light text-foreground-secondary">
      HABI is pre-release, so versions below are development milestones rather than published
      packages. Everything listed is in the product today.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-24">
    {
      releases.length === 0 ? (
        <p class="border-t border-border py-12 text-body font-light text-muted-foreground">
          Nothing released yet.
        </p>
      ) : (
        <ol>
          {releases.map(({ id, data, Content }) => (
            <li class="border-t border-border py-12 first:border-t-0 first:pt-0">
              <article
                class="grid gap-6 md:grid-cols-[9rem_1fr] md:gap-10"
                aria-labelledby={`release-${id}`}
              >
                <div class="md:pt-1">
                  <p class="font-mono text-label text-foreground">{data.version}</p>
                  <time
                    class="mt-1 block text-label font-light text-muted-foreground"
                    datetime={data.date.toISOString().slice(0, 10)}
                  >
                    {dateFormat.format(data.date)}
                  </time>

                  {data.kinds.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-1.5 md:flex-col md:items-start">
                      {data.kinds.map((kind) => (
                        <li
                          class:list={[
                            'rounded-full border border-border px-2 py-0.5 text-micro font-light',
                            KIND_TONE[kind],
                          ]}
                        >
                          {KIND_LABEL[kind]}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <div class="min-w-0">
                  <h2
                    id={`release-${id}`}
                    class="text-section font-light tracking-tight text-foreground"
                  >
                    {data.title}
                  </h2>

                  <p class="mt-2 text-body font-light text-muted-foreground">{data.summary}</p>

                  <div class="release-notes mt-6 text-secondary font-light">
                    <Content />
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center">
      <h2 class="text-headline font-light">Try the latest</h2>
      <p class="mx-auto mt-3 max-w-lg text-body font-light text-muted-foreground">
        Everything above is live. Nothing to install, nothing to sign up for.
      </p>
      <a
        href={appOrigin}
        class="mt-7 inline-flex h-10 items-center rounded-md bg-accent px-5 text-body font-normal text-accent-foreground transition-colors duration-[--duration-fast] hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
      >
        Open the playground
      </a>
    </div>
  </section>
</Base>
