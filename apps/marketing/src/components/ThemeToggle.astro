---
/**
 * Three-way appearance control.
 *
 * No React on this site — the theme controller in `@mai-habi/ui` is
 * framework-free, so a few lines of client script is the whole cost.
 * The mode is always named in text; icons alone never carry it.
 */
---

<fieldset
  class="flex items-center gap-0.5 rounded-md border border-border p-0.5"
  data-theme-switcher
>
  <legend class="sr-only">Appearance</legend>

  {
    (['light', 'dark', 'system'] as const).map((mode) => (
      <label
        class="cursor-pointer rounded-sm px-2 py-1 text-micro font-light text-muted-foreground transition-colors duration-[--duration-fast] hover:text-foreground has-[:checked]:bg-surface-active has-[:checked]:text-foreground has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-focus-ring"
      >
        <input type="radio" name="appearance" value={mode} class="sr-only" />
        <span class="capitalize">{mode}</span>
      </label>
    ))
  }
</fieldset>

<script>
  import { getThemeState, setThemeMode, subscribeTheme } from '@mai-habi/ui/theme-controller';

  for (const group of document.querySelectorAll<HTMLElement>('[data-theme-switcher]')) {
    const inputs = group.querySelectorAll<HTMLInputElement>('input[name="appearance"]');

    const paint = () => {
      const { mode } = getThemeState();
      for (const input of inputs) input.checked = input.value === mode;
    };

    for (const input of inputs) {
      input.addEventListener('change', () => {
        if (input.checked) setThemeMode(input.value as 'light' | 'dark' | 'system');
      });
    }

    paint();
    subscribeTheme(paint);
  }
</script>
