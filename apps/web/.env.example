# Origin the app is served from. Used for share links.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional. Without these the playground runs in guest-only mode:
# projects stay in IndexedDB, share links carry their payload inline, and the
# API Builder stays in draft-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Encrypts each user's Vercel access token in an HTTP-only cookie.
# Generate a long random value and never prefix this variable with NEXT_PUBLIC_.
VERCEL_CONNECTION_SECRET=
