---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { THEME_INIT_SCRIPT } from '@mai-habi/ui';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'Create, run and share browser projects.',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <!--
      Resolves the theme before the first paint. Anything later — an island, a
      stylesheet, a framework hook — would show a light frame first.
    -->
    <script is:inline set:html={THEME_INIT_SCRIPT} />
  </head>
  <body class:list={['bg-background font-light text-foreground antialiased', bodyClass]}>
    <slot />
  </body>
</html>
