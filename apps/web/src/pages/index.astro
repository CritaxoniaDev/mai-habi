---
import Base from '../layouts/Base.astro';
import AuthMenu from '../islands/AuthMenu';
import DashboardActions from '../islands/DashboardActions';
import ProjectList from '../islands/ProjectList';
import ThemeControl from '../islands/ThemeControl';
import MigrationPrompt from '../islands/MigrationPrompt';
---

<Base title="Projects — Playground">
  <!--
    Static chrome. No Monaco, no compiler and no WebAssembly is downloaded on
    this page — those load only inside /editor.
  -->
  <header class="border-b border-border bg-surface">
    <div class="mx-auto flex h-12 max-w-5xl items-center justify-between px-6">
      <a
        href="/"
        class="rounded-sm px-1 text-secondary font-normal text-foreground outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
      >
        Playground
      </a>
      <div class="flex items-center gap-1.5">
        <ThemeControl client:idle />
        <AuthMenu client:idle />
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-6 py-14">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-page font-light">Projects</h1>
        <p class="mt-1.5 text-secondary font-light text-muted-foreground">
          Write HTML, CSS, JavaScript, or React in the browser. Compiled on your machine,
          shared with a link.
        </p>
      </div>
      <DashboardActions client:load />
    </div>

    <ProjectList client:load />

    <p class="mt-6 text-label font-light text-muted-foreground">
      Projects are stored in this browser. Sign in only if you want them somewhere else.
    </p>
  </main>

  <MigrationPrompt client:idle />
</Base>
