---
import Base from '../../layouts/Base.astro';
---

<Base title="Signing in — Code">
  <main class="grid h-screen place-items-center px-6 text-center">
    <div>
      <p class="text-section font-light">Signing you in</p>
      <p class="mt-1.5 text-secondary font-light text-muted-foreground">This only takes a moment.</p>
      <noscript>
        <p class="mt-4 text-secondary font-light text-danger">
          JavaScript is required to complete sign-in.
        </p>
      </noscript>
    </div>
  </main>
</Base>

<script>
  import { getSupabase } from '@mai-habi/shared';

  // The client is configured with detectSessionInUrl, so creating it consumes
  // the token in the callback URL before we navigate away.
  void getSupabase().then(() => {
    window.location.replace('/');
  });
</script>
